<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OpenTK" Version="4.9.4" />
		<PackageReference Include="OpenTK.Windowing.Desktop" Version="4.9.4" />
		<PackageReference Include="System.Drawing.Common" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Shaders\*.glsl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <None Include="bin\Debug\net8.0-windows\Data\DepthMap_11.dat" />
	  <None Include="bin\Debug\net8.0-windows\Data\DepthMap_5.dat" />
	  <None Include="bin\Debug\net8.0-windows\Data\DepthMap_Test.dat" />
	  <None Include="bin\Debug\net8.0-windows\Rendering\fragment.glsl" />
	  <None Include="bin\Debug\net8.0-windows\Rendering\vertex.glsl" />
	</ItemGroup>
</Project>
